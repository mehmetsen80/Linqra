    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^5.0.3"
  },
  "dependencies": {
    "html-react-parser": "^6.1.3",
    "lucide-react": "^1.22.0",
    "mermaid": "^11.16.0",
